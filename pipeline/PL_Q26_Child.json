							},
							"FileName": {
								"value": "@pipeline().parameters.file",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"Schema": {
				"type": "string"
			},
			"table": {
				"type": "string"
			},
			"file": {
				"type": "string"
			}
		},
